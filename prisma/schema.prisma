generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model AppSettings {
  id                       String   @id @default(cuid())
  shop                     String   @unique
  addProductReplicaEnabled Boolean  @default(true)
  dashboardEnabled         Boolean  @default(false)
  additionalEnabled        Boolean  @default(false)
  reportEnabled            Boolean  @default(false)
  storeErrorReportEnabled  Boolean  @default(false)
  merchandisingEnabled     Boolean  @default(true)
  storeDetails             Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String
  price         Float
  productLimit  Int
  isActive      Boolean            @default(true)
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions ShopSubscription[]
}

model ShopSubscription {
  id                String           @id @default(cuid())
  shop              String           @unique
  planId            String
  status            String           @default("active")
  chargeId          String?          @unique
  productsUsed          Int              @default(0)
  periodProductLimit    Int?
  billingCycleStart     DateTime         @default(now())
  billingCycleEnd       DateTime?
  trialProductsUsed Int              @default(0)
  triedPlanIds      String           @default("")
  freeBasicScanUsed Boolean          @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
}

model UsageHistory {
  id              String   @id @default(cuid())
  shop            String
  date            DateTime @default(now())
  productsCreated Int      @default(0)
  planName        String
  planLimit       Int
  createdAt       DateTime @default(now())

  @@index([shop, date])
}

model ShopReview {
  id        String    @id @default(cuid())
  shop      String    @unique
  rating    Int       @default(0)
  feedback  String?
  dismissed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Public, cross-shop feature-request board. Merchants submit requests and upvote
// existing ones; the app prioritizes the highest-voted. Votes are one-per-shop.
model FeatureRequest {
  id            String               @id @default(cuid())
  title         String
  description   String
  tags          String               @default("") // space-separated normalized keywords for similarity matching
  status        String               @default("open") // open | planned | in_progress | done | declined
  createdByShop String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  votes         FeatureRequestVote[]

  @@index([status])
}

// ── Public website (shopflixai.com) — store scans, leads, passwordless auth ──
// A scan of a public store URL run from the marketing site. Dedup is by
// storeDomain: one free Basic scan per store, then login + payment required.
model WebScan {
  id          String   @id @default(cuid())
  storeDomain String   // normalized host (dedup key), e.g. "mystore.com"
  storeUrl    String   // full normalized https URL scanned
  ip          String?  // logged for abuse detection
  userAgent   String?
  score       Int      @default(0)
  riskLevel   String   @default("Unknown") // High | Medium | Low
  totalIssues Int      @default(0)
  highCount   Int      @default(0)
  preview     Json?    // free-preview issues (no fix text)
  fullResult  Json?    // full mapped issues incl. fixes — gated behind payment
  paidTier    String?  // basic | advanced | deep once purchased
  email       String?  // captured at login/checkout
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeDomain])
  @@index([ip])
  @@index([email])
}

model WebUser {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  lastLogin DateTime?
}

// One-time login codes (passwordless). Code is stored HASHED, never plaintext.
model WebOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model FeatureRequestVote {
  id        String         @id @default(cuid())
  requestId String
  shop      String
  createdAt DateTime       @default(now())
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, shop])
  @@index([shop])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  ipAddress String?
  userAgent String?
  status    String   @default("new") // new, read, replied, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model ProductAICheck {
  id        String   @id @default(uuid())
  productId String   @unique
  shop      String
  status    String // e.g., 'PENDING', 'COMPLETE', 'ERROR'
  result    Json?
  aiCheckCompleted Boolean @default(false)
  autoFixCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([shop])
}

model StoreScan {
  id        String   @id @default(uuid())
  shop      String
  type      String   @default("BASIC") // BASIC, ADVANCED, DEEP
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETE, FAILED
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model StoreMonitor {
  id             String    @id @default(uuid())
  shop           String    @unique
  enabled        Boolean   @default(false)
  frequency      String    @default("weekly") // daily | weekly
  email          String
  storeUrl       String
  lastRunAt      DateTime?
  lastIssueCount Int       @default(0)
  baseline       Json?     // string[] of issue fingerprints from the last run
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum AdminBannerState {
  PENDING
  COMPLETE
  ERROR
}
